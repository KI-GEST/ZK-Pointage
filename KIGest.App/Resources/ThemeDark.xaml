<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Thème Sombre « Tech Glass » — UI/UX Pro Max (Glassmorphism) ===== -->

    <!-- ===== Couleurs ===== -->
    <Color x:Key="Color.Background">#0F172A</Color>
    <Color x:Key="Color.Card">#1B2336</Color>
    <Color x:Key="Color.CardGlass">#C01B2336</Color>
    <Color x:Key="Color.Primary">#1E293B</Color>
    <Color x:Key="Color.Secondary">#334155</Color>
    <Color x:Key="Color.Muted">#272F42</Color>
    <Color x:Key="Color.Border">#475569</Color>
    <Color x:Key="Color.BorderStrong">#5B6B85</Color>
    <Color x:Key="Color.Foreground">#F8FAFC</Color>
    <Color x:Key="Color.MutedForeground">#94A3B8</Color>
    <Color x:Key="Color.Accent">#22C55E</Color>
    <Color x:Key="Color.AccentBright">#4ADE80</Color>
    <Color x:Key="Color.AccentDim">#16A34A</Color>
    <Color x:Key="Color.OnAccent">#0F172A</Color>
    <Color x:Key="Color.Destructive">#EF4444</Color>
    <Color x:Key="Color.Ring">#FFFFFF</Color>

    <!-- Rouge de la marque (icône KI-GEST Pointage #FF4055) -->
    <Color x:Key="Color.Brand">#FF4055</Color>
    <Color x:Key="Color.BrandBright">#FF6B7F</Color>
    <Color x:Key="Color.BrandDim">#D9263F</Color>
    <Color x:Key="Color.OnBrand">#FFFFFF</Color>
    <Color x:Key="Color.BrandSoft">#33FF4055</Color>

    <!-- Statuts de présence -->
    <Color x:Key="Color.Status.Present">#22C55E</Color>
    <Color x:Key="Color.Status.Late">#F59E0B</Color>
    <Color x:Key="Color.Status.Absent">#EF4444</Color>
    <Color x:Key="Color.Status.Leave">#3B82F6</Color>
    <Color x:Key="Color.Status.Holiday">#8B5CF6</Color>
    <Color x:Key="Color.Status.Rest">#64748B</Color>

    <!-- ===== Pinceaux ===== -->
    <LinearGradientBrush x:Key="Brush.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#111C35" Offset="0.5"/>
        <GradientStop Color="#0B1020" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Card" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#212B44" Offset="0"/>
        <GradientStop Color="#1B2336" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Primary" Color="{DynamicResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.Secondary" Color="{DynamicResource Color.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="{DynamicResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.Foreground" Color="{DynamicResource Color.Foreground}"/>
    <SolidColorBrush x:Key="Brush.MutedForeground" Color="{DynamicResource Color.MutedForeground}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{DynamicResource Color.AccentBright}"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}"/>
    <SolidColorBrush x:Key="Brush.Destructive" Color="{DynamicResource Color.Destructive}"/>
    <SolidColorBrush x:Key="Brush.Ring" Color="{DynamicResource Color.Ring}"/>

    <!-- Rouge de la marque -->
    <SolidColorBrush x:Key="Brush.Brand" Color="{DynamicResource Color.Brand}"/>
    <SolidColorBrush x:Key="Brush.BrandBright" Color="{DynamicResource Color.BrandBright}"/>
    <SolidColorBrush x:Key="Brush.BrandDim" Color="{DynamicResource Color.BrandDim}"/>
    <SolidColorBrush x:Key="Brush.OnBrand" Color="{DynamicResource Color.OnBrand}"/>
    <SolidColorBrush x:Key="Brush.BrandSoft" Color="{DynamicResource Color.BrandSoft}"/>
    <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF5A6C" Offset="0"/>
        <GradientStop Color="#FF4055" Offset="0.55"/>
        <GradientStop Color="#D9263F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.BrandGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5A6C" Offset="0"/>
        <GradientStop Color="#FF4055" Offset="0.5"/>
        <GradientStop Color="#C91F37" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.Status.Present" Color="{DynamicResource Color.Status.Present}"/>
    <SolidColorBrush x:Key="Brush.Status.Late" Color="{DynamicResource Color.Status.Late}"/>
    <SolidColorBrush x:Key="Brush.Status.Absent" Color="{DynamicResource Color.Status.Absent}"/>
    <SolidColorBrush x:Key="Brush.Status.Leave" Color="{DynamicResource Color.Status.Leave}"/>
    <SolidColorBrush x:Key="Brush.Status.Holiday" Color="{DynamicResource Color.Status.Holiday}"/>
    <SolidColorBrush x:Key="Brush.Status.Rest" Color="{DynamicResource Color.Status.Rest}"/>

    <!-- ===== Espacements et formes ===== -->
    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">8</Thickness>
    <Thickness x:Key="Space.M">12</Thickness>
    <Thickness x:Key="Space.L">16</Thickness>
    <Thickness x:Key="Space.XL">24</Thickness>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Size.Row">32</sys:Double>

    <!-- ===== Polices ===== -->
    <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- ===== Styles de texte ===== -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.MutedForeground}"/>
    </Style>

    <Style x:Key="Text.Kpi" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
    </Style>

    <!-- ===== Carte glass ===== -->
    <Style x:Key="Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.L}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DataGrid ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#0FFFFFFF"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.Muted}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedForeground}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Secondary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Muted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ===== Boutons animés ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Secondary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.MutedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Ring}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Bouton « marque » (rouge #FF4055) ===== -->
    <Style x:Key="Style.ButtonBrand" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnBrand}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BrandDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{DynamicResource Brush.Brand}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.BrandBright}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.BrandDim}"/>
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.OnBrand}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
