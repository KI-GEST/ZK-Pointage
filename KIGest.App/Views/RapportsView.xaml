<Page x:Class="KIGest.App.Views.RapportsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="RapportsView"
      Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Rapports" Style="{DynamicResource Text.Title}" FontSize="24" Margin="0,0,0,4"/>
            <TextBlock Text="États journalier et mensuel par employé et par service — exports Excel et PDF, et export paie (heures sup 125 % / 150 % / 200 %)"
                       Style="{DynamicResource Text.Label}" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="2">

            <!-- ============ Onglet Journalier ============ -->
            <TabItem Header="Journalier">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Date" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DtpJournalier" Width="150" Height="30" Margin="0,0,12,0"/>
                        <TextBlock Text="Service" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CboServiceJour" Width="220" Height="30" DisplayMemberPath="Libelle" Margin="0,0,12,0"/>
                        <Button x:Name="BtnGenererJournalier" Content="Générer" Height="32" Padding="20,0" Style="{DynamicResource Style.ButtonBrand}" FontWeight="SemiBold" Click="BtnGenererJournalier_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="GrdJournalier" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="90"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="150"/>
                            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="150"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="130"/>
                            <DataGridTextColumn Header="Entrée" Binding="{Binding Entree}" Width="70"/>
                            <DataGridTextColumn Header="Sortie" Binding="{Binding Sortie}" Width="70"/>
                            <DataGridTextColumn Header="H. trav." Binding="{Binding HeuresTravaillees}" Width="70"/>
                            <DataGridTextColumn Header="Retard" Binding="{Binding RetardMin}" Width="70"/>
                            <DataGridTextColumn Header="Dép. ant." Binding="{Binding DepartAnticipeMin}" Width="70"/>
                            <DataGridTextColumn Header="H. sup" Binding="{Binding HeuresSup}" Width="70"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnExcelJournalier" Content="Exporter Excel" Height="34" Padding="16,0" Margin="0,0,8,0" Click="BtnExcelJournalier_Click" IsEnabled="False"/>
                        <Button x:Name="BtnPdfJournalier" Content="Exporter PDF" Height="34" Padding="16,0" Click="BtnPdfJournalier_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ Onglet Mensuel par employé ============ -->
            <TabItem Header="Mensuel (par employé)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Mois" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DtpMensuel" Width="150" Height="30" Margin="0,0,12,0" ToolTip="Choisissez un jour du mois concerné"/>
                        <TextBlock Text="Service" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CboServiceMensuel" Width="220" Height="30" DisplayMemberPath="Libelle" Margin="0,0,12,0"/>
                        <Button x:Name="BtnGenererMensuel" Content="Générer" Height="32" Padding="20,0" Style="{DynamicResource Style.ButtonBrand}" FontWeight="SemiBold" Click="BtnGenererMensuel_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="GrdMensuel" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="90"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="150"/>
                            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="150"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="130"/>
                            <DataGridTextColumn Header="J. présents" Binding="{Binding JoursPresents}" Width="90"/>
                            <DataGridTextColumn Header="Absences" Binding="{Binding Absences}" Width="80"/>
                            <DataGridTextColumn Header="Retards" Binding="{Binding Retards}" Width="80"/>
                            <DataGridTextColumn Header="Min. retard" Binding="{Binding TotalRetardMin}" Width="90"/>
                            <DataGridTextColumn Header="H. trav." Binding="{Binding HeuresTravaillees}" Width="80"/>
                            <DataGridTextColumn Header="H. sup" Binding="{Binding HeuresSup}" Width="80"/>
                            <DataGridTextColumn Header="Congés" Binding="{Binding Conges}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnExcelMensuel" Content="Exporter Excel" Height="34" Padding="16,0" Margin="0,0,8,0" Click="BtnExcelMensuel_Click" IsEnabled="False"/>
                        <Button x:Name="BtnPdfMensuel" Content="Exporter PDF" Height="34" Padding="16,0" Click="BtnPdfMensuel_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ Onglet Mensuel par service ============ -->
            <TabItem Header="Mensuel (par service)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Mois" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DtpService" Width="150" Height="30" Margin="0,0,12,0"/>
                        <Button x:Name="BtnGenererService" Content="Générer" Height="32" Padding="20,0" Style="{DynamicResource Style.ButtonBrand}" FontWeight="SemiBold" Click="BtnGenererService_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="GrdService" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="220"/>
                            <DataGridTextColumn Header="Effectif" Binding="{Binding Effectif}" Width="80"/>
                            <DataGridTextColumn Header="J. présence" Binding="{Binding JoursPresents}" Width="90"/>
                            <DataGridTextColumn Header="Absences" Binding="{Binding Absences}" Width="80"/>
                            <DataGridTextColumn Header="Retards" Binding="{Binding Retards}" Width="80"/>
                            <DataGridTextColumn Header="Min. retard" Binding="{Binding TotalRetardMin}" Width="90"/>
                            <DataGridTextColumn Header="H. trav." Binding="{Binding HeuresTravaillees}" Width="90"/>
                            <DataGridTextColumn Header="H. sup" Binding="{Binding HeuresSup}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnExcelService" Content="Exporter Excel" Height="34" Padding="16,0" Margin="0,0,8,0" Click="BtnExcelService_Click" IsEnabled="False"/>
                        <Button x:Name="BtnPdfService" Content="Exporter PDF" Height="34" Padding="16,0" Click="BtnPdfService_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ Onglet Export paie ============ -->
            <TabItem Header="Export paie (H. sup)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Mois" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DtpPaie" Width="150" Height="30" Margin="0,0,12,0"/>
                        <Button x:Name="BtnGenererPaie" Content="Générer" Height="32" Padding="20,0" Style="{DynamicResource Style.ButtonBrand}" FontWeight="SemiBold" Click="BtnGenererPaie_Click"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Style="{DynamicResource Text.Label}" Margin="0,0,0,12"
                               Text="H. sup 125 % = heures au-delà du seuil journalier. 150 % = horaire de nuit. 200 % = travaillées un férié ou un repos (taux configurables dans Paramètres → Heures sup)." TextWrapping="Wrap"/>

                    <DataGrid x:Name="GrdPaie" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="90"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="140"/>
                            <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="140"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="120"/>
                            <DataGridTextColumn Header="J. présence" Binding="{Binding JoursPresents}" Width="90"/>
                            <DataGridTextColumn Header="H. normales" Binding="{Binding HeuresNormales}" Width="95"/>
                            <DataGridTextColumn Header="H. sup 125 %" Binding="{Binding Sup125}" Width="95"/>
                            <DataGridTextColumn Header="H. sup 150 %" Binding="{Binding Sup150}" Width="95"/>
                            <DataGridTextColumn Header="H. sup 200 %" Binding="{Binding Sup200}" Width="95"/>
                            <DataGridTextColumn Header="Total H. sup" Binding="{Binding TotalSup}" Width="95"/>
                            <DataGridTextColumn Header="Absences" Binding="{Binding Absences}" Width="80"/>
                            <DataGridTextColumn Header="Congés" Binding="{Binding Conges}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnExcelPaie" Content="Exporter paie (Excel)" Height="34" Padding="16,0" Margin="0,0,8,0" Click="BtnExcelPaie_Click" IsEnabled="False"/>
                        <Button x:Name="BtnPdfPaie" Content="Exporter paie (PDF)" Height="34" Padding="16,0" Click="BtnPdfPaie_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
