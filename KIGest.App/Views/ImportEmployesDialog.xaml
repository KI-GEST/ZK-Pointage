<Window x:Class="KIGest.App.Views.ImportEmployesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importer les employés depuis la pointeuse" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Importer les employés depuis la pointeuse" Style="{DynamicResource Text.Title}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Pointeuse :" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboPointeuse" Width="220" Height="30" DisplayMemberPath="Nom" Margin="0,0,12,0"/>
                    <Button x:Name="BtnLire" Content="Lire les employés" Width="150" Height="30" Margin="0,0,12,0" Click="BtnLire_Click"/>
                    <TextBlock Text="Découpage du nom :" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboDecoupage" Width="140" Height="30" Margin="0,0,12,0" SelectionChanged="CboDecoupage_SelectionChanged"/>
                    <Button Content="Tout cocher" Width="110" Height="30" Margin="0,0,8,0" Click="BtnToutCocher_Click"/>
                    <Button Content="Tout décocher" Width="120" Height="30" Click="BtnToutDecocher_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatut" Style="{DynamicResource Text.Body}" VerticalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="GrdUtilisateurs" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Importer" Binding="{Binding Selectionner, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Badge (pointeuse)" Binding="{Binding BadgeNumero}" IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="Nom (appareil)" Binding="{Binding NomAppareil}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                <DataGridTextColumn Header="Déjà en base" Binding="{Binding Statut}" IsReadOnly="True" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtInfo" Grid.Row="3" Style="{DynamicResource Text.Label}" Margin="0,10,0,0"
                   Text="Astuce : si le nom sur la pointeuse est « Prénom NOM », il est automatiquement scindé. Vous pouvez corriger avant d'importer."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnImporter" Content="Importer" Width="130" Height="32" Margin="0,0,8,0" Click="BtnImporter_Click" IsEnabled="False"/>
            <Button Content="Annuler" Width="110" Height="32" Click="BtnAnnuler_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
