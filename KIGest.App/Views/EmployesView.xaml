<Page x:Class="KIGest.App.Views.EmployesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EmployesView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre d'actions -->
        <Border Style="{DynamicResource Style.Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Recherche" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtRecherche" Width="200" Height="32"
                             TextChanged="TxtRecherche_TextChanged"
                             ToolTip="Rechercher par nom, prénom, matricule ou badge"/>
                    <TextBlock Text="Pointeuse" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="CboPointeuse" Width="190" Height="32" Margin="0,0,8,0"
                              DisplayMemberPath="Nom" SelectionChanged="CboPointeuse_SelectionChanged"
                              ToolTip="Afficher uniquement les employés enregistrés sur la pointeuse sélectionnée"/>
                    <TextBlock Text="Statut" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboActif" Width="120" Height="32" SelectionChanged="CboActif_SelectionChanged"/>
                    <Button Content="Réinitialiser" Height="32" Padding="12,0" Margin="8,0,0,0" Click="BtnReinitialiser_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnExporterVersPointeuse" Content="Exporter vers la pointeuse" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnExporterVersPointeuse_Click"
                            ToolTip="Envoyer tous les employés présents en base vers la pointeuse (écraser)"/>
                    <Button x:Name="BtnImporterPointeuse" Content="Importer depuis la pointeuse" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnImporterPointeuse_Click"
                            ToolTip="Lire les employés inscrits sur une pointeuse et les créer/mettre à jour en base"/>
                    <Button Content="Services" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnServices_Click"
                            ToolTip="Gérer les services / départements"/>
                    <Button Content="Actualiser" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnActualiser_Click"/>
                    <Button x:Name="BtnNouveau" Content="Nouvel employé" Height="32" Padding="16,0" Click="BtnNouveau_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tableau -->
        <Border Grid.Row="1" Style="{DynamicResource Style.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="GrdEmployes" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="GrdEmployes_SelectionChanged" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="110"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="180"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="180"/>
                        <DataGridTextColumn Header="N° badge" Binding="{Binding BadgeNumero}" Width="110"/>
                        <DataGridTextColumn Header="CIN" Binding="{Binding CIN}" Width="120"/>
                        <DataGridTextColumn Header="Service" Binding="{Binding Service.Libelle}" Width="180"/>
                        <DataGridTextColumn Header="Date d'embauche" Binding="{Binding DateEmbauche, StringFormat=dd/MM/yyyy}" Width="130"/>
                        <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnModifier" Content="Modifier" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnModifier_Click"/>
                        <Button x:Name="BtnSupprimer" Content="Supprimer" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnSupprimer_Click"/>
                        <Button x:Name="BtnBasculerActif" Content="Activer / Désactiver" Height="32" Padding="16,0" Click="BtnBasculerActif_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtTotal" Style="{DynamicResource Text.Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
