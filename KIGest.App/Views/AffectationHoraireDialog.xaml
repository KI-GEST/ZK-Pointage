<Window x:Class="KIGest.App.Views.AffectationHoraireDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle affectation" Height="380" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Nouvelle affectation" Style="{DynamicResource Text.Title}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtCible" Style="{DynamicResource Text.Label}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Horaire" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
            <ComboBox x:Name="CboHoraire" Grid.Row="0" Grid.Column="1" Height="32" DisplayMemberPath="Libelle" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date début" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
            <DatePicker x:Name="DtpDebut" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,0,0,12" SelectedDateFormat="Long"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Date fin (optionnel)" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
            <DatePicker x:Name="DtpFin" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,0,12" SelectedDateFormat="Long"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="" />
            <Button x:Name="BtnEffacerFin" Grid.Row="3" Grid.Column="1" Content="Aucune date de fin" Height="32" Padding="0" HorizontalAlignment="Left" Click="BtnEffacerFin_Click"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnEnregistrer" Content="Enregistrer" Height="32" Width="130" Margin="0,0,8,0" Click="BtnEnregistrer_Click" IsDefault="True"/>
            <Button Content="Annuler" Height="32" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
