<Window x:Class="KIGest.App.Views.EmployeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employé" Height="640" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitre" Text="Nouvel employé" Style="{DynamicResource Text.Title}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Matricule" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtMatricule" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nom" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtNom" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Prénom" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtPrenom" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Badge (pointeuse)" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtBadge" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="CIN" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox x:Name="TxtCin" Grid.Row="4" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Service" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox x:Name="CboService" Grid.Row="5" Grid.Column="1" Height="30" DisplayMemberPath="Libelle"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Date d'embauche" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <DatePicker x:Name="DtpEmbauche" Grid.Row="6" Grid.Column="1" Height="30" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Actif" Style="{DynamicResource Text.Label}" VerticalAlignment="Center"/>
                <CheckBox x:Name="CboActif" Grid.Row="7" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
            </Grid>
        </ScrollViewer>

        <!-- Attributs personnalisés -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Attributs personnalisés" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnAjouterAttribut" Content="+ Ajouter" Height="28" Padding="10,0" FontSize="11" Click="BtnAjouterAttribut_Click"/>
                </StackPanel>
                <DataGrid x:Name="GrdAttributs" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Height="100" Margin="0,6,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Attribut" Binding="{Binding Cle}" Width="200"/>
                        <DataGridTextColumn Header="Valeur" Binding="{Binding Valeur}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Enregistrer" Width="110" Height="32" Margin="0,0,8,0" Click="BtnEnregistrer_Click"/>
            <Button Content="Annuler" Width="110" Height="32" Click="BtnAnnuler_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
