<Page x:Class="KIGest.App.Views.ParametresView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:KIGest.App.Views"
      Title="ParametresView"
      Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Paramètres" Style="{DynamicResource Text.Title}" FontSize="24" Margin="0,0,0,4"/>
            <TextBlock Text="Configuration complète du système — toutes les modifications sont enregistrées dans la base POINTAGE"
                       Style="{DynamicResource Text.Label}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu latéral des sections -->
            <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="Sections" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox x:Name="LstGroupes" Background="Transparent" BorderThickness="0" FontWeight="Normal"
                             SelectionChanged="LstGroupes_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="0,1" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Secondary}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Muted}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Contenu de la section -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border x:Name="IconBadge" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.Accent}" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtIconBadge" Text="◆" FontSize="14" Foreground="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="TxtTitreSection" Text="Configuration" Style="{DynamicResource Text.Title}" FontSize="18"/>
                            <TextBlock x:Name="TxtDescriptionSection" Text="" Style="{DynamicResource Text.Label}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="ScrollSection" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel x:Name="PanneauParametres"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre d'état + actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatut" Text="" Style="{DynamicResource Text.Label}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnReinitialiser" Content="Rétablir les défauts" Height="36" Padding="16,0" Margin="0,0,8,0" Click="BtnReinitialiser_Click"/>
                <Button x:Name="BtnEnregistrer" Content="Enregistrer" Height="36" Width="140" Click="BtnEnregistrer_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
