<Window x:Class="KIGest.App.Views.CorrigerPresenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Corriger le pointage" Height="420" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitre" Text="Corriger le pointage" Style="{DynamicResource Text.Title}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtDate" Style="{DynamicResource Text.Label}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- Entrée -->
            <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkEntree" Content="Entrée" VerticalAlignment="Center" IsChecked="True"/>
                    <TextBox x:Name="TxtEntree" Grid.Column="1" Height="32" Margin="8,0" FontFamily="{DynamicResource Font.Mono}"/>
                    <Button x:Name="BtnEntree" Grid.Column="2" Content="Effacer" Height="32" Click="BtnEntree_Click" ToolTip="Ne pas corriger l'entrée"/>
                </Grid>
            </Border>

            <!-- Sortie -->
            <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkSortie" Content="Sortie" VerticalAlignment="Center" IsChecked="True"/>
                    <TextBox x:Name="TxtSortie" Grid.Column="1" Height="32" Margin="8,0" FontFamily="{DynamicResource Font.Mono}"/>
                    <Button x:Name="BtnSortie" Grid.Column="2" Content="Effacer" Height="32" Click="BtnSortie_Click" ToolTip="Ne pas corriger la sortie"/>
                </Grid>
            </Border>

            <TextBlock Text="Motif de la correction *" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMotif" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
            <TextBlock Text="Les pointages bruts sur la pointeuse ne sont pas modifiés. Une entrée/sortie corrigée sera appliquée à toutes les lectures depuis la base."
                       Style="{DynamicResource Text.Label}" TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnEffacer" Content="Effacer la correction" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnEffacer_Click"/>
            <Button x:Name="BtnEnregistrer" Content="Enregistrer" Height="32" Width="120" Margin="0,0,8,0" IsDefault="True" Click="BtnEnregistrer_Click"/>
            <Button Content="Annuler" Height="32" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
