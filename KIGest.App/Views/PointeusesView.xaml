<Page x:Class="KIGest.App.Views.PointeusesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PointeusesView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pointeuses" Style="{DynamicResource Text.Title}" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des pointeuses -->
            <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Liste" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox x:Name="LstPointeuses" Grid.Row="1" SelectionChanged="LstPointeuses_SelectionChanged" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Ajouter" Height="32" Padding="12,0" Click="BtnAjouter_Click"/>
                        <Button Content="Supprimer" Height="32" Padding="12,0" Margin="8,0,0,0" Click="BtnSupprimer_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Configuration -->
            <Border Grid.Column="1" Style="{DynamicResource Style.Card}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Configuration de la pointeuse" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox x:Name="TxtNom" Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Adresse IP" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox x:Name="TxtIp" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Port" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox x:Name="TxtPort" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Text="4370"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Clé de communication" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox x:Name="TxtCommKey" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Text="0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="N° Machine" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBox x:Name="TxtMachineNo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,16" Text="1"/>

                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnEnregistrer" Content="Enregistrer" Height="32" Padding="16,0" Click="BtnEnregistrer_Click"/>
                                <Button x:Name="BtnTest" Content="Vérifier la connexion" Height="32" Padding="16,0" Margin="8,0,0,0" Click="BtnTest_Click"/>
                                <Button x:Name="BtnDisconnect" Content="Déconnecter" Height="32" Padding="16,0" Margin="8,0,0,0" Click="BtnDisconnect_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- Opérations sur la pointeuse -->
                        <TextBlock Text="Actions sur l'appareil" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,24,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Button x:Name="BtnSyncTime" Content="Synchroniser l'heure" Height="32" Padding="12,0" HorizontalAlignment="Stretch" Margin="0,0,4,4" Click="BtnSyncTime_Click"/>
                                <Button x:Name="BtnReboot" Content="Redémarrer" Height="32" Padding="12,0" HorizontalAlignment="Stretch" Margin="0,0,4,4" Click="BtnReboot_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Button x:Name="BtnClearLogs" Content="Effacer les pointages" Height="32" Padding="12,0" HorizontalAlignment="Stretch" Margin="4,0,0,4" Click="BtnClearLogs_Click"/>
                                <Button x:Name="BtnClearData" Content="Effacer TOUTES les données" Height="32" Padding="12,0" HorizontalAlignment="Stretch" Margin="4,0,0,4" Click="BtnClearData_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="État de la connexion" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtStatus" Text="Non testé" Style="{DynamicResource Text.Body}"/>
                                <TextBlock x:Name="TxtStatusDetail" Text="" Style="{DynamicResource Text.Label}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
