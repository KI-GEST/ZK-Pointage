<Page x:Class="KIGest.App.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DashboardView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tableau de bord" Style="{DynamicResource Text.Title}" Margin="0,0,0,16"/>

        <!-- Cartes KPI -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Pointages aujourd'hui" Style="{DynamicResource Text.Label}"/>
                    <TextBlock x:Name="KpiPointages" Text="0" Style="{DynamicResource Text.Kpi}"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Employés actifs" Style="{DynamicResource Text.Label}"/>
                    <TextBlock x:Name="KpiEmployes" Text="0" Style="{DynamicResource Text.Kpi}"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Pointeuses" Style="{DynamicResource Text.Label}"/>
                    <TextBlock x:Name="KpiPointeuses" Text="0" Style="{DynamicResource Text.Kpi}"/>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Style.Card}">
                <StackPanel>
                    <TextBlock Text="Paramètres" Style="{DynamicResource Text.Label}"/>
                    <TextBlock x:Name="KpiParametres" Text="0" Style="{DynamicResource Text.Kpi}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- État des pointeuses -->
        <Border Grid.Row="2" Style="{DynamicResource Style.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="VoyantSync" Width="12" Height="12" Fill="{DynamicResource Brush.Status.Present}" Margin="0,0,8,0"/>
                        <TextBlock Text="Derniers pointages" Style="{DynamicResource Text.Body}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkAutoSync" Content="Synchroniser auto (temps réel)" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
                                  Checked="ChkAutoSync_Changed" Unchecked="ChkAutoSync_Changed"/>
                        <Button x:Name="BtnSyncMaintenant" Content="Synchroniser maintenant" Height="30" Padding="12,0" Click="BtnSyncMaintenant_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="GrdPointages" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Heure" Binding="{Binding DateHeure, StringFormat=HH:mm:ss}" Width="90"/>
                        <DataGridTemplateColumn Header="Entrée / Sortie" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstSortie}" Value="True">
                                                            <Setter Property="Fill" Value="#3B82F6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SensAffiche}" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstSortie}" Value="True">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Parti tôt" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PartiTotAffichee}" VerticalAlignment="Center" Margin="4,0"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Absent}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="—">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.MutedForeground}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="100"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="180"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="180"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateHeure, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModeAffiche}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtSync" Grid.Row="2" Style="{DynamicResource Text.Label}" Margin="0,10,0,0"
                           Text="Dernière synchronisation : jamais"/>
            </Grid>
        </Border>

        <!-- État des pointeuses -->
        <Border Grid.Row="3" Style="{DynamicResource Style.Card}" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="État des pointeuses" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <DataGrid x:Name="GrdPointeuses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="180"/>
                        <DataGridTextColumn Header="Adresse IP" Binding="{Binding AdresseIP}" Width="180"/>
                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="90"/>
                        <DataGridTextColumn Header="Emplacement" Binding="{Binding Emplacement}" Width="220"/>
                        <DataGridTextColumn Header="Dernière synchro" Binding="{Binding DerniereSynchro, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/>
                        <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
