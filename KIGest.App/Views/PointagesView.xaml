<Page x:Class="KIGest.App.Views.PointagesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:KIGest.App.Services"
      Title="PointagesView"
      Unloaded="Page_Unloaded">
    <Page.Resources>
        <conv:CodeZKTecoConverter x:Key="CodeConverter"/>
        <conv:BoolToTextConverter x:Key="ImportConverter" Vrai="Importé" Faux="Non importé"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pointages bruts" Style="{DynamicResource Text.Title}" Margin="0,0,0,16"/>

        <!-- Import -->
        <Border Grid.Row="1" Style="{DynamicResource Style.Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Importer depuis une pointeuse" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Pointeuse" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboPointeuse" Width="260" Height="32" DisplayMemberPath="Nom" SelectionChanged="CboPointeuse_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnConnecter" Content="Se connecter" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnConnecter_Click"/>
                    <Button x:Name="BtnDeconnecter" Content="Déconnecter" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnDeconnecter_Click" IsEnabled="False"/>
                    <Button x:Name="BtnLire" Content="Lire les pointages" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnLire_Click" IsEnabled="False"/>
                    <Button x:Name="BtnImporter" Content="Importer dans la base" Height="32" Padding="16,0" Click="BtnImporter_Click" IsEnabled="False"/>
                </StackPanel>

                <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="État :" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtConnexion" Text="Déconnecté" Style="{DynamicResource Text.Body}"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtImportStatus" Style="{DynamicResource Text.Label}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Filtres + tableau -->
        <Border Grid.Row="2" Style="{DynamicResource Style.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Pointages enregistrés dans la base POINTAGE" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <!-- Filtres -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Du" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DtpDu" Width="140" Height="30" Margin="0,0,12,0" SelectedDateChanged="DtpDu_SelectedDateChanged"/>

                            <TextBlock Text="Au" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DtpAu" Width="140" Height="30" Margin="0,0,12,0" SelectedDateChanged="DtpAu_SelectedDateChanged"/>

                            <TextBlock Text="N° badge" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtBadgeFiltre" Width="110" Height="30" Margin="0,0,12,0" KeyDown="TxtBadgeFiltre_KeyDown"/>

                            <TextBlock Text="Employé" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtEmployeFiltre" Width="200" Height="30" Margin="0,0,12,0" KeyDown="TxtEmployeFiltre_KeyDown"/>

                            <ComboBox x:Name="CboPointeuseFiltre" Width="180" Height="30" Margin="0,0,12,0" DisplayMemberPath="Nom"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Filtrer" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnFiltrer_Click"/>
                            <Button Content="Réinitialiser" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnReinitialiser_Click"/>
                            <Button x:Name="BtnActualiser" Content="Actualiser la liste" Height="32" Padding="16,0" Click="BtnActualiser_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="GrdPointages" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="120"/>
                        <DataGridTextColumn Header="Corr." Binding="{Binding Corrigee}" Width="50"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="160"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="160"/>
                        <DataGridTextColumn Header="Date et heure" Binding="{Binding DateHeure, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="170"/>
                        <DataGridTextColumn Header="Mode de vérification" Binding="{Binding ModeVerification, Converter={StaticResource CodeConverter}, ConverterParameter=Mode}" Width="210"/>
                        <DataGridTextColumn Header="Sens" Binding="{Binding SensES, Converter={StaticResource CodeConverter}, ConverterParameter=Sens}" Width="100"/>
                        <DataGridTextColumn Header="Pointeuse" Binding="{Binding PointeuseNom}" Width="160"/>
                        <DataGridTextColumn Header="État de l'import" Binding="{Binding Importe, Converter={StaticResource ImportConverter}}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtTotal" Grid.Row="3" Style="{DynamicResource Text.Label}" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- ===== Bandeau de chargement (design animé) ===== -->
        <Grid x:Name="OverlayChargement" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <!-- Fond dégradé sombre + halo -->
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.42" RadiusX="1.1" RadiusY="1.1">
                    <GradientStop Color="#C90F172A" Offset="0"/>
                    <GradientStop Color="#E60B1020" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Ellipse Width="520" Height="520" Opacity="0.16" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{DynamicResource Brush.Accent}">
                <Ellipse.Effect>
                    <BlurEffect Radius="140"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Carte de chargement -->
            <Border Width="470" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="16" Padding="30,26"
                    Background="#FF141B2E" BorderBrush="#FF2A3A57" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
                <StackPanel>
                    <!-- Liseré d'accent -->
                    <Border Height="3" CornerRadius="2" Margin="0,0,0,22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="0.25"/>
                                <GradientStop Color="#86EFAC" Offset="0.5"/>
                                <GradientStop Color="#22C55E" Offset="0.75"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- En-tête : spinner + titre -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                        <!-- Spinner animé -->
                        <Grid Width="74" Height="74" Margin="0,0,18,0">
                            <Ellipse Stroke="#22324E" StrokeThickness="5"/>
                            <Ellipse x:Name="ArcSpinner" Stroke="#22C55E" StrokeThickness="5"
                                     StrokeDashArray="8 4" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5" Opacity="0.95">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="ArcSpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#22C55E"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="30" Height="30" Fill="#16233A" Stroke="#2A3A57" StrokeThickness="1"/>
                            <TextBlock x:Name="TxtSpinnerGlifo" Text="⏱" FontSize="15" Foreground="#22C55E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtChargementTitre" Text="Lecture des pointages…"
                                       FontSize="16.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtChargementDetail" Text="Connexion à la pointeuse…"
                                       FontSize="12" Foreground="#8FA3BF" Margin="0,5,0,0"/>
                            <!-- Points animés -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#22C55E" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="Dot1Scale"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="#22C55E" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="Dot2Scale"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="#22C55E" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="Dot3Scale"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Barre de progression avec reflet animé -->
                    <Border x:Name="BarreTrack" Height="8" CornerRadius="4" Background="#16233A" ClipToBounds="True" Margin="0,0,0,14">
                        <Grid>
                            <Border x:Name="BarreProgressionSegment" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource Brush.Accent}"/>
                            <Rectangle x:Name="BarreProgressionReflet" Width="110" Height="8" Opacity="0.9">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="BarreProgressionRefletTranslate" X="-110"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- Progression / détail -->
                    <Grid>
                        <TextBlock x:Name="TxtChargementSousTitre" Text="Veuillez patienter pendant le traitement…"
                                   Style="{DynamicResource Text.Label}" FontSize="10.5" Foreground="#7C8DAB"/>
                        <TextBlock x:Name="TxtProgression" Text="" Style="{DynamicResource Text.Label}" FontSize="11"
                                   Foreground="#34D399" HorizontalAlignment="Right" FontFamily="{DynamicResource Font.Mono}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
