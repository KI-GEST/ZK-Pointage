<Page x:Class="KIGest.App.Views.PresencesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:KIGest.App.Services"
      Title="PresencesView">
    <Page.Resources>
        <conv:StatutPresenceConverter x:Key="StatutConverter"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Présences" Style="{DynamicResource Text.Title}" Margin="0,0,0,16"/>

        <!-- Barre de filtres -->
        <Border Grid.Row="1" Style="{DynamicResource Style.Card}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Vue" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboVue" Width="150" Height="30" Margin="0,0,12,0" SelectionChanged="CboVue_SelectionChanged"/>

                    <TextBlock x:Name="LblDate" Text="Depuis le" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DtpDate" Width="150" Height="30" Margin="0,0,12,0" SelectedDateChanged="DtpDate_SelectedDateChanged"/>

                    <TextBlock x:Name="LblMois" Text="Mois" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="CboMois" Width="130" Height="30" Margin="0,0,12,0" Visibility="Collapsed" SelectionChanged="CboMois_SelectionChanged"/>

                    <TextBlock Text="Service" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboService" Width="180" Height="30" DisplayMemberPath="Libelle" Margin="0,0,12,0" SelectionChanged="CboService_SelectionChanged"/>

                    <TextBlock Text="Recherche" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtRecherche" Width="180" Height="30" TextChanged="TxtRecherche_TextChanged"/>

                    <TextBlock Text="Statut" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="CboStatut" Width="140" Height="30" SelectionChanged="CboStatut_SelectionChanged"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnCalculer" Content="Calculer les présences" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnCalculer_Click"/>
                    <Button x:Name="BtnEnregistrer" Content="Enregistrer en base" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnEnregistrer_Click" IsEnabled="False"/>
                    <Button x:Name="BtnCorriger" Content="Corriger l'heure…" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnCorriger_Click" IsEnabled="False"
                            ToolTip="Modifier l'heure d'entrée ou de sortie de la ligne sélectionnée"/>
                    <Button x:Name="BtnExcel" Content="Export Excel" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnExcel_Click"/>
                    <TextBlock x:Name="TxtStatut" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Bandeau d'avertissement : employés sans horaire -->
                <Border x:Name="BarreAvertissement" Visibility="Collapsed"
                        Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6"
                        Padding="12,10" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#9888;" FontSize="14" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtAvertissement" Style="{DynamicResource Text.Body}" Foreground="#92400E" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Contenu -->
        <Border Grid.Row="2" Style="{DynamicResource Style.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtTitre" Text="Détail journalier" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <DataGrid x:Name="GrdPresences" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeight="32" ColumnHeaderHeight="32" CanUserResizeRows="False"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionChanged="GrdPresences_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Secondary}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Corrigee}" Value="True">
                                    <Setter Property="Background" Value="#FFFEF9C3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Secondary}" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,1,0,1" Padding="10,6" Margin="0,2,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource Text.Body}"
                                                       FontWeight="SemiBold" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Style="{DynamicResource Text.Label}" Margin="0,0,12,0"
                                                       Text="{Binding ItemCount, StringFormat={}{0} jour(s)}"/>
                                            <TextBlock Grid.Column="3" Style="{DynamicResource Text.Label}"
                                                       Text="Une ligne par jour"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="105"/>
                        <DataGridTextColumn Header="Jour" Binding="{Binding JourSemaine}" Width="90"/>
                        <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" Width="95"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="130"/>
                        <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="130"/>
                        <DataGridTextColumn Header="Entrée" Binding="{Binding EntreeAffichee}" Width="70"/>
                        <DataGridTextColumn Header="Sortie" Binding="{Binding SortieAffichee}" Width="70"/>
                        <DataGridTextColumn Header="Heures" Binding="{Binding HeuresAffichee}" Width="85"/>
                        <DataGridTextColumn Header="Retard" Binding="{Binding RetardAffichee}" Width="80"/>
                        <DataGridTextColumn Header="Dép. anticipé" Binding="{Binding DepartAffichee}" Width="100"/>
                        <DataGridTemplateColumn Header="Parti tôt" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PartiTotAffichee}" VerticalAlignment="Center" Margin="4,0"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Absent}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="—">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.MutedForeground}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Heures sup" Binding="{Binding HeuresSupAffichee}" Width="90"/>
                        <DataGridTextColumn Header="Horaire" Binding="{Binding HoraireAffiche}" Width="130"/>
                        <DataGridTemplateColumn Header="Statut" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Statut, Converter={StaticResource StatutConverter}, ConverterParameter=Icone}"
                                                   Foreground="{Binding Statut, Converter={StaticResource StatutConverter}, ConverterParameter=Texte}"
                                                   FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Statut, Converter={StaticResource StatutConverter}, ConverterParameter=Libelle}"
                                                   Foreground="{Binding Statut, Converter={StaticResource StatutConverter}, ConverterParameter=Texte}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Alerte" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Alerte}" FontSize="11"
                                               Style="{DynamicResource Text.Body}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="4,0"
                                               ToolTip="{Binding Alerte}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Légende :" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="✔ P — Présent" Style="{DynamicResource Text.Label}" Foreground="#15803D"/>
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="⏱ R — Retard" Style="{DynamicResource Text.Label}" Foreground="#B45309"/>
                    </Border>
                    <Border Background="#FEE2E2" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="✖ A — Absent" Style="{DynamicResource Text.Label}" Foreground="#B91C1C"/>
                    </Border>
                    <Border Background="#DBEAFE" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="✈ C — Congé" Style="{DynamicResource Text.Label}" Foreground="#1D4ED8"/>
                    </Border>
                    <Border Background="#EDE9FE" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="★ F — Férié" Style="{DynamicResource Text.Label}" Foreground="#6D28D9"/>
                    </Border>
                    <Border Background="#E2E8F0" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="— Repos" Style="{DynamicResource Text.Label}" Foreground="#475569"/>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="○ Pas de pointage" Style="{DynamicResource Text.Label}" Foreground="#A8B5C7"/>
                    </Border>
                    <TextBlock Text="Les dimanches sont des jours de repos (semaine 5 j)." Style="{DynamicResource Text.Label}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
