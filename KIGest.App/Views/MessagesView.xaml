<Page x:Class="KIGest.App.Views.MessagesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MessagesView"
      Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Messages sur la pointeuse" Style="{DynamicResource Text.Title}" FontSize="24" Margin="0,0,0,4"/>
            <TextBlock Text="Envoyer des messages courts sur les appareils (public ou ciblant un employé)" Style="{DynamicResource Text.Label}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulaire -->
            <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Nouveau message" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="Titre" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTitre" Height="32" Margin="0,0,0,12"/>

                    <TextBlock Text="Contenu" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContenu" Height="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkPublic" Content="Message public (tous les employés)" IsChecked="True" Margin="0,0,0,12"/>

                    <TextBlock Text="Cibler un employé (si non public)" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboEmploye" Height="32" DisplayMemberPath="Affichage" Margin="0,0,0,12"/>

                    <TextBlock Text="Pointeuse" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboPointeuse" Height="32" DisplayMemberPath="Nom" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnEnvoyer" Content="Envoyer" Height="36" Padding="24,0" Margin="0,0,8,0" Click="BtnEnvoyer_Click" IsDefault="True"/>
                        <Button x:Name="BtnEffacer" Content="Effacer" Height="36" Padding="16,0" Click="BtnEffacer_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Historique -->
            <Border Grid.Column="1" Style="{DynamicResource Style.Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Messages envoyés" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid x:Name="GrdMessages" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateCreation, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Titre" Binding="{Binding Titre}" Width="180"/>
                            <DataGridTextColumn Header="Public" Binding="{Binding EstPublic}" Width="80"/>
                            <DataGridTextColumn Header="Actif" Binding="{Binding Actif}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
