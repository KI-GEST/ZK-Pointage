<Page x:Class="KIGest.App.Views.CongesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CongesView"
      Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Congés &amp; jours fériés" Style="{DynamicResource Text.Title}" FontSize="24" Margin="0,0,0,4"/>
            <TextBlock Text="Demandes de congés (avec approbation) et calendrier des jours fériés — pris en compte par le calcul de présence"
                       Style="{DynamicResource Text.Label}" TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="2">

            <!-- ============ Onglet Congés ============ -->
            <TabItem Header="Congés">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Liste des demandes -->
                    <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Demandes de congés" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <DataGrid x:Name="GrdConges" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GrdConges_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employé" Binding="{Binding EmployeAffiche}" Width="200"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                    <DataGridTextColumn Header="Du" Binding="{Binding DateDebut, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Au" Binding="{Binding DateFin, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="110"/>
                                    <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnApprouver" Content="Approuver" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnApprouver_Click" IsEnabled="False"/>
                                <Button x:Name="BtnRefuser" Content="Refuser" Height="32" Padding="16,0" Margin="0,0,8,0" Click="BtnRefuser_Click" IsEnabled="False"/>
                                <Button x:Name="BtnSupprimer" Content="Supprimer" Height="32" Padding="16,0" Click="BtnSupprimer_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nouvelle demande -->
                    <Border Grid.Column="1" Style="{DynamicResource Style.Card}" Margin="8,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Nouvelle demande" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <TextBlock Text="Employé" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboEmploye" Height="34" DisplayMemberPath="Affichage" Margin="0,0,0,12"/>

                            <TextBlock Text="Type" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CboType" Height="34" Margin="0,0,0,12">
                                <ComboBoxItem Content="Congé annuel" IsSelected="True"/>
                                <ComboBoxItem Content="Maladie"/>
                                <ComboBoxItem Content="Maternité"/>
                                <ComboBoxItem Content="Paternité"/>
                                <ComboBoxItem Content="Sans solde"/>
                                <ComboBoxItem Content="Autorisation de sortie"/>
                                <ComboBoxItem Content="Autre"/>
                            </ComboBox>

                            <TextBlock Text="Du" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DtpDebut" Margin="0,0,0,12" SelectedDate="{x:Null}"/>

                            <TextBlock Text="Au" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DtpFin" Margin="0,0,0,12"/>

                            <TextBlock Text="Motif" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtMotif" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                            <Button x:Name="BtnEnregistrer" Content="Enregistrer la demande" Height="38" Padding="0"
                                    Style="{DynamicResource Style.ButtonBrand}" FontWeight="SemiBold" Click="BtnEnregistrer_Click"/>

                            <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                                <TextBlock Text="Seuls les congés « Approuvé » sont comptés comme congés dans le calcul de présence." Style="{DynamicResource Text.Label}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Onglet Jours fériés ============ -->
            <TabItem Header="Jours fériés">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- Liste -->
                    <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Jours fériés (année en cours)" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <DataGrid x:Name="GrdFeries" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GrdFeries_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="130"/>
                                    <DataGridTextColumn Header="Jour" Binding="{Binding Jour}" Width="120"/>
                                    <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnSupprimerFerie" Content="Supprimer" Height="32" Padding="16,0" Click="BtnSupprimerFerie_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Ajouter -->
                    <Border Grid.Column="1" Style="{DynamicResource Style.Card}" Margin="8,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Ajouter un jour férié" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <TextBlock Text="Date" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DtpFerie" Margin="0,0,0,12"/>

                            <TextBlock Text="Libellé" Style="{DynamicResource Text.Label}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtLibelleFerie" Height="32" Margin="0,0,0,12"/>

                            <Button x:Name="BtnAjouterFerie" Content="Ajouter" Height="36" Padding="0" Style="{DynamicResource Style.ButtonBrand}" FontWeight="SemiBold" Click="BtnAjouterFerie_Click"/>

                            <Button x:Name="BtnSeedTunisie" Content="Insérer les fériés tunisiens 2026" Height="34" Padding="0" Margin="0,12,0,0" Click="BtnSeedTunisie_Click"/>

                            <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                                <TextBlock Text="Fériés tunisiens : 01/01, 20/03, 09/04, 01/05, 25/07, 13/08, 17/12. Les fêtes religieuses (Aïd, Mouled) ont des dates variables — saisissez-les chaque année."
                                           Style="{DynamicResource Text.Label}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
