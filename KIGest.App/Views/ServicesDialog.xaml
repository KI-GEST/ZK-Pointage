<Window x:Class="KIGest.App.Views.ServicesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Services" Height="440" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Services / départements" Style="{DynamicResource Text.Title}" Margin="0,0,0,16"/>

        <DataGrid x:Name="GrdServices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="GrdServices_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Identifiant" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*"/>
                <DataGridTextColumn Header="Employés" Binding="{Binding NombreEmployes}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtLibelle" Height="32" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnAjouter" Content="Ajouter" Width="90" Height="32" Margin="0,0,8,0" Click="BtnAjouter_Click"/>
                <Button x:Name="BtnRenommer" Content="Renommer" Width="100" Height="32" Margin="0,0,8,0" Click="BtnRenommer_Click"/>
                <Button x:Name="BtnSupprimer" Content="Supprimer" Width="90" Height="32" Click="BtnSupprimer_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Width="110" Height="32" Click="BtnFermer_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
