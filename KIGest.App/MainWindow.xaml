<Window x:Class="KIGest.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KI-GEST Pointage" Height="768" Width="1366"
        Icon="pack://application:,,,/Resources/pointage.ico"
        Background="{DynamicResource Brush.Background}"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource Brush.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- Bandeau de marque -->
                <Border Background="{DynamicResource Brush.BrandGradientVertical}" Padding="16,20">
                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="36" Background="#FFFFFF" HorizontalAlignment="Left" Padding="9">
                            <Image Source="pack://application:,,,/Resources/pointage.ico" Width="54" Height="54"/>
                        </Border>
                        <TextBlock Text="KI-GEST" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="P O I N T A G E" Foreground="#FFE3E8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Filet rouge signature -->
                <Border Height="4" Background="{DynamicResource Brush.Brand}"/>
                <StackPanel Margin="8,8,8,0">
                    <Button Content="Tableau de bord" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavDashboard_Click"/>
                    <Button Content="Employés" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavEmployes_Click"/>
                    <Button Content="Pointeuses" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavPointeuses_Click"/>
                    <Button Content="Pointages" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavPointages_Click"/>
                    <Button Content="Présences" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavPresences_Click"/>
                    <Button Content="Horaires" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavHoraires_Click"/>
                    <Button Content="Congés" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavConges_Click"/>
                    <Button Content="Work Codes" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavWorkCodes_Click"/>
                    <Button Content="Messages" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavMessages_Click"/>
                    <Button Content="Sauvegarde" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavSauvegarde_Click"/>
                    <Button Content="Rapports" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavRapports_Click"/>
                    <Button x:Name="BtnNavUtilisateurs" Content="Utilisateurs" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavUtilisateurs_Click"/>
                    <Button Content="Paramètres" Margin="0,4" HorizontalAlignment="Stretch" Height="32" Click="NavParametres_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- En-tête (souligné rouge marque) -->
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Brand}" BorderThickness="0,0,0,3" Padding="16,12">
            <Grid>
                <TextBlock x:Name="TxtTitreEcran" Text="Tableau de bord" Style="{DynamicResource Text.Title}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnToggleTheme" Height="32" Padding="10,0" Margin="0,0,12,0"
                            Click="BtnToggleTheme_Click" ToolTip="Basculer entre thème sombre et clair">
                        <TextBlock x:Name="TxtThemeLabel" Text="Thème : Sombre" FontWeight="SemiBold"/>
                    </Button>
                    <Border Background="{DynamicResource Brush.Muted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtSessionUser" Text="—" Style="{DynamicResource Text.Label}" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="BtnChangerMdp" Content="Changer MDP" Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnChangerMdp_Click"/>
                    <Button x:Name="BtnLogout" Content="Déconnexion" Height="32" Padding="10,0" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="16">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" />
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource Brush.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock x:Name="TxtVersion" Text="KI-GEST Pointage v1.1.0" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock Text="Présence &amp; pointage — ZKTeco" Style="{DynamicResource Text.Label}" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
